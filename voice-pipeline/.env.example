# Sarvam — saaras:v4 for listening (live + language detection). The voice is
# Cartesia (below). See docs/Voice_Model_Choices.md.
SARVAM_API_KEY=

# The publicly reachable base URL of the rag-backend service (no trailing
# path) — this pipeline calls <this>/v1/chat/completions for every answer,
# for both /voice/en and /voice/ta. Must be reachable from wherever this
# voice-pipeline process runs.
RAG_BACKEND_PUBLIC_URL=

# Bearer token rag-backend checks on /v1/chat/completions.
RAG_BACKEND_AUTH_KEY=

# Comma-separated list of origins allowed to open /voice/en or /voice/ta.
# Use "*" only for local dev — lock this to your real site origin(s) before
# deploying.
WIDGET_ALLOWED_ORIGINS=*

# Port this service listens on (run with: uvicorn server:app --port $PORT)
PORT=8001

# Turn-taking (turn_taking.py). All optional — these are the defaults.
# TURN_MODE=local   local VAD + barge-in rules + end-of-turn model (default)
# TURN_MODE=sarvam  previous behaviour: Sarvam's server VAD decides everything
TURN_MODE=local
# End-of-turn per starting language: "smart" (smart-turn model) or "silence"
# (fixed timeout). Tamil defaults to silence — smart-turn does not list Tamil.
TURN_STOP_EN=smart
TURN_STOP_TA=silence
# Seconds the visitor must keep talking before a speaking bot is interrupted.
# 0 = interrupt on any speech (then "okay" cuts the bot off again).
BARGE_IN_SUSTAIN_SECS=0.4
# Silence (after the VAD's own 0.2s) that ends a turn in "silence" mode.
TURN_SILENCE_TIMEOUT_SECS=0.5
# Silence after which Sarvam releases a final transcript (local mode only).
STT_SEGMENT_SILENCE_MS=300
# Longest "smart" mode waits in silence when it thinks the visitor isn't done.
SMART_TURN_MAX_WAIT_SECS=1.5

# Seconds Pipecat waits for a TTS reply's audio before giving up on it (its own
# default, 3.0, is shorter than a cloned voice's slowest first audio).
TTS_STOP_FRAME_TIMEOUT_SECS=10

# Speaking: Cartesia (since 2026-10-18; listening and answers stay on Sarvam).
CARTESIA_API_KEY=
# A voice id from the Cartesia voice library, or one of your own clones.
CARTESIA_VOICE_ID=
# Optional: model (default sonic-3.6).
CARTESIA_MODEL=
# Delivery. Speed 0.6-1.5 (1.0 = normal), volume 0.5-2.0, emotion e.g. calm,
# content, enthusiastic. Unset = the voice's defaults.
CARTESIA_SPEED=
CARTESIA_VOLUME=
CARTESIA_EMOTION=
# Buffering. Default:
# sentence by sentence with Cartesia's buffer off. "token" streams words as the
# LLM writes them; then CARTESIA_MAX_BUFFER_DELAY_MS (0-5000) sets Cartesia's buffer.
CARTESIA_TEXT_AGGREGATION=
CARTESIA_MAX_BUFFER_DELAY_MS=
