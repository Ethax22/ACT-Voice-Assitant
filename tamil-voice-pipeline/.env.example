# Sarvam (Tamil voice) — saaras:v4 for STT, bulbul:v3 for TTS. See
# docs/Voice_Model_Choices.md.
SARVAM_API_KEY=

# The publicly reachable base URL of the rag-backend service (no trailing
# path) — this pipeline calls <this>/v1/chat/completions for every answer,
# same as the Deepgram English path. Must be reachable from wherever this
# Tamil pipeline process runs.
RAG_BACKEND_PUBLIC_URL=

# Bearer token rag-backend checks on /v1/chat/completions.
RAG_BACKEND_AUTH_KEY=

# Comma-separated list of origins allowed to open /voice/ta. Use "*" only
# for local dev — lock this to your real site origin(s) before deploying.
WIDGET_ALLOWED_ORIGINS=*

# Port this service listens on (run with: uvicorn server:app --port $PORT)
PORT=8001
