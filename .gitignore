.env
*.pyc

# Google service account keys — full write access to the leads Sheet, never commit
rag-backend/secrets/
*service-account*.json
venv/
.venv/
*.log

# Phase 10 — conversation logs (transcripts + audio). Real visitor data,
# 90-day auto-pruned at runtime — never committed.
rag-backend/logs/
