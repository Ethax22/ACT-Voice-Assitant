# Sentiment reports built from those logs (sentiment_report.py) — same data.
rag-backend/reports/
# scenario_test.py: cached synthetic visitor clips and per-run results
voice-pipeline/.scenario_clips/
voice-pipeline/scenario_results/
# make_voice_samples.py output (audio for choosing a voice by ear)
voice-pipeline/voice_samples/

# OS / editor junk — unrelated to the project, shouldn't ever be committed
.DS_Store
Thumbs.db
nohup.out
.vscode/
.idea/
*.swp

# Python packaging/test cache noise
.pytest_cache/
*.egg-info/

# Student ERP data (marks/attendance) - never commit
docs/ERP Data/

