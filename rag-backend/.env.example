# Azure OpenAI Service — EMBEDDINGS ONLY as of 2026-09-25 (chat moved to
# Sarvam 105B below; Sarvam has no public embeddings API yet, so retriever.py
# keeps its own separate Azure OpenAI client for embeddings).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=              # e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview  # must match exactly what your deployment page's sample code shows — Azure 404s on a mismatched version even with a correct deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=  # your Azure deployment name for embeddings (e.g. text-embedding-3-small)

# Comma-separated list of origins allowed to call /widget/chat (the browser-
# facing route). Use "*" only for local dev — lock this to your real site
# origin(s) before deploying, e.g. https://act.edu.in
WIDGET_ALLOWED_ORIGINS=*

# The publicly reachable base URL of THIS backend (no trailing path) — the
# voice-pipeline service (Tamil now, English once Phase 3 lands) calls back
# into it at <this>/v1/chat/completions. Must be a real HTTPS URL reachable
# from wherever that service runs; localhost will NOT work if they're on
# different hosts. For local dev, tunnel with ngrok (or similar) and put the
# tunnel URL here; in production, use your deployed backend's real URL.
RAG_BACKEND_PUBLIC_URL=

# Sarvam — as of 2026-09-25, this is the ONLY vendor key: it covers the LLM
# (sarvam-105b, used directly by this backend's chat client in main.py) and,
# via the voice pipeline, Saaras STT / Bulbul TTS for both languages. See
# docs/Voice_Model_Choices.md.
SARVAM_API_KEY=

# Your own bearer token — checked by rag-backend, used by Deepgram's custom
# LLM endpoint call, the Tamil pipeline's LLM call, and the widget's proxy.
RAG_BACKEND_AUTH_KEY=
