# Azure OpenAI Service (confirmed with Prakash — using Azure, not direct OpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=              # e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview  # must match exactly what your deployment page's sample code shows — Azure 404s on a mismatched version even with a correct deployment name
AZURE_OPENAI_DEPLOYMENT=            # your Azure deployment name for the chat model (e.g. gpt-4o-mini)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=  # your Azure deployment name for embeddings (e.g. text-embedding-3-small)

# Comma-separated list of origins allowed to call /widget/chat (the browser-
# facing route). Use "*" only for local dev — lock this to your real site
# origin(s) before deploying, e.g. https://act.edu.in
WIDGET_ALLOWED_ORIGINS=*

# Deepgram (English voice) — Flux for both STT (flux-general-en) and
# TTS (flux-hannah-en), v2. See docs/Voice_Model_Choices.md.
DEEPGRAM_API_KEY=

# The publicly reachable base URL of THIS backend (no trailing path) —
# Deepgram's cloud servers call back into it at <this>/v1/chat/completions
# via the voice agent's think.endpoint. Must be a real HTTPS URL Deepgram can
# reach; localhost will NOT work. For local dev, tunnel with ngrok (or
# similar) and put the tunnel URL here; in production, use your deployed
# backend's real URL.
RAG_BACKEND_PUBLIC_URL=

# Sarvam (Tamil voice) — used by tamil-voice-pipeline, not this backend
# directly, but kept here too in case you run both services from one place.
# saaras:v4 for STT, bulbul:v3 for TTS. See docs/Voice_Model_Choices.md.
SARVAM_API_KEY=

# Your own bearer token — checked by rag-backend, used by Deepgram's custom
# LLM endpoint call, the Tamil pipeline's LLM call, and the widget's proxy.
RAG_BACKEND_AUTH_KEY=
